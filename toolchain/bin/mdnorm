#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

# ==============================================================================
# SCRIPT: mdnorm (toolchain/bin/mdnorm)
# DESCRIPCIÓN:
#   Linter y normalizador de archivos Markdown para Obsidian y Pandoc (LuaLaTeX / EPUB).
#   Hace solo cambios mínimos y deja todo lo demás tal cual: no reformatea párrafos,
#   títulos, fórmulas ni código.
#
#   Lo que arregla y verifica:
#     1. Líneas en blanco antes de títulos (#), listas, tablas, citas (>) e imágenes
#        sueltas en su línea. Corrige sangrías de sublistas para Pandoc y cambia
#        <br> sueltos fuera de tablas por saltos de línea válidos de Markdown (\).
#     2. Tablas: une filas partidas en varias líneas, completa columnas faltantes
#        en el encabezado/separador y reemplaza <br> dentro de celdas por espacios.
#     3. Imágenes (Obsidian y Markdown estándar): comprueba que todas las imágenes
#        referenciadas existan en el repositorio/vault (assets/). Convierte
#        ![[foto.png]] a ![](../../assets/foto.png) preservando compatibilidad
#        visual con Obsidian (si tiene |300 o |derecha lo conserva como ![[...|300]]
#        para no ensuciar Obsidian con {width=...}, dejando que md2pdf lo traduzca
#        al compilar). Limpia epígrafes basura de Notion (![image.png]).
#     4. Cabecera YAML: agrega espacio tras ":", cierra comillas rotas, entrecomilla
#        valores con ": ", " #" o caracteres especiales de YAML, agrega el "---" de
#        cierre si falta, avisa de claves repetidas y valida la cabecera con pandoc.
#     5. Fórmulas y caracteres matemáticos: convierte \( ... \) y \[ ... \] a
#        $ ... $ y $$ ... $$, y normaliza letras matemáticas Unicode (𝐴, 𝑓, 𝛼 -> A, f, α).
#     6. Exportaciones de Notion: pasa "# Título" + propiedades al frontmatter YAML
#        y convierte bloques <aside>...</aside> en citas (>).
#
# USO:
#   toolchain/bin/mdnorm nota.md          (Normaliza un archivo; pregunta antes de guardar)
#   toolchain/bin/mdnorm a.md b.md        (Varios archivos; pregunta por cada uno)
#   toolchain/bin/mdnorm                  (Todos los .md de la carpeta actual)
#   toolchain/bin/mdnorm -v nota.md       (-v o --verbose: muestra el diff línea por línea)
#   toolchain/bin/mdnorm -y nota.md       (-y o --yes: guarda sin preguntar)
#   toolchain/bin/mdnorm --check nota.md  (-n o --check: modo linter para CI; no modifica
#                                          archivos y devuelve exit 1 si hay cambios
#                                          pendientes, errores YAML o imágenes faltantes)
# ==============================================================================

set -uo pipefail

# --- Comprobaciones previas ---------------------------------------------------
if ! command -v perl >/dev/null 2>&1; then
  echo "❌ Error: falta 'perl'." >&2
  exit 1
fi

# --- Opciones -----------------------------------------------------------------
uso="Uso: mdnorm [-y|--yes] [-v|--verbose] [-n|--check] [archivo.md ...]"
opcion_y=0
opcion_v=0
opcion_check=0
args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -y|--yes)     opcion_y=1; shift ;;
    -v|--verbose) opcion_v=1; shift ;;
    -n|--check)   opcion_check=1; shift ;;
    -h|--help)
      sed -n '4,40p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    --) shift; while [[ $# -gt 0 ]]; do args+=("$1"); shift; done ;;
    -*)
      echo "❌ Opción no válida: $1. $uso" >&2
      exit 1
      ;;
    *) args+=("$1"); shift ;;
  esac
done

# --- 1. Lista de archivos -----------------------------------------------------
archivos=()
if (( ${#args[@]} > 0 )); then
  for archivo in "${args[@]}"; do
    if [[ ! -f "$archivo" ]]; then
      echo "⚠️ Saltando '$archivo': no existe."
    elif [[ ! "${archivo,,}" =~ \.(md|markdown)$ ]]; then
      echo "⚠️ Saltando '$archivo': no es un archivo Markdown (.md)."
    else
      archivos+=("$archivo")
    fi
  done
else
  shopt -s nullglob nocaseglob
  for f in *.md *.markdown; do
    [[ -f "$f" ]] && archivos+=("$f")
  done
  shopt -u nullglob nocaseglob
fi

if (( ${#archivos[@]} == 0 )); then
  echo "No se encontraron archivos Markdown para normalizar."
  exit 0
fi

# --- Dónde buscar las imágenes por nombre --------------------------------------
carpeta_de_busqueda() {
  local carpeta d raiz home_abs
  carpeta="$(cd "$1" && pwd -P)"
  d="$carpeta"
  home_abs="$(cd "$HOME" && pwd -P)"
  while [[ "$d" != "/" ]]; do
    if [[ -d "$d/.obsidian" ]]; then
      printf '%s\n' "$d"
      return
    fi
    d="$(dirname "$d")"
  done
  if command -v git >/dev/null 2>&1 && raiz="$(git -C "$carpeta" rev-parse --show-toplevel 2>/dev/null)"; then
    printf '%s\n' "$raiz"
  elif [[ "$(dirname "$carpeta")" == "/" || "$(dirname "$carpeta")" == "$home_abs" ]]; then
    printf '%s\n' "$carpeta"
  else
    printf '%s\n' "$(dirname "$carpeta")"
  fi
}

# --- El normalizador (perl) ---------------------------------------------------
read -r -d '' NORMALIZAR <<'PERL' || true
use strict; use warnings; use utf8;
use File::Find; use File::Basename qw(basename); use File::Spec;
use Encode qw(encode decode); use Unicode::Normalize qw(NFC NFD NFKC);
sub fs  { encode("UTF-8", $_[0]) }
sub txt { decode("UTF-8", $_[0]) }
my $carpeta = txt($ENV{CARPETA_MD});
my $base    = txt($ENV{BASE});
my %indice; my $indexado = 0;
my $faltan = 0;   # imágenes que no se encontraron
my $avisos = 0;   # otros avisos (clave repetida, imagen con texto después del |)

# --- Imágenes ---
sub buscar {
  my ($ruta) = @_;
  for my $v ($ruta, NFC($ruta), NFD($ruta)) {
    return "$carpeta/$v" if -f fs("$carpeta/$v");
    return "$base/$v"    if -f fs("$base/$v");
  }
  if (!$indexado) {
    my $raiz = fs($base);
    find({ no_chdir => 1, wanted => sub {
      if (-d $_ && basename($_) =~ /^\./ && $_ ne $raiz) { $File::Find::prune = 1; return; }
      if (-f $_) { my $r = txt($_); push @{ $indice{NFC(basename($r))} }, $r; }
    } }, $raiz);
    $indexado = 1;
  }
  my @c = @{ $indice{NFC(basename($ruta))} || [] };
  my $fin = NFC("/$ruta");
  my @exactos = grep { my $n = NFC($_); substr($n, -length($fin)) eq $fin } @c;
  @c = @exactos if @exactos;
  return undef unless @c;
  my %dist = map { my $r = File::Spec->abs2rel($_, $carpeta); ($_ => scalar(split m{/}, $r)) } @c;
  return (sort { $dist{$a} <=> $dist{$b} || $a cmp $b } @c)[0];
}

sub ruta_md {
  my ($abs) = @_;
  my $rel = File::Spec->abs2rel($abs, $carpeta);
  $rel =~ s/([ ()<>#%])/sprintf("%%%02X", ord($1))/ge;
  return $rel;
}

sub imagen_obsidian {
  my ($original, $dentro) = @_;
  my ($destino, @extra) = split /\|/, $dentro;
  $destino =~ s/\\$//; $destino =~ s/^\s+|\s+$//g;
  return $original if $destino =~ /#/;                      # sección de una nota
  return $original unless $destino =~ /\.(png|jpe?g|gif|bmp|webp|svg|pdf)$/i;
  my (@attr, $raro);
  for my $t (@extra) {
    $t =~ s/\\$//; $t =~ s/^\s+|\s+$//g;
    if    ($t =~ /^(\d+)(?:x\d+)?$/)           { push @attr, "width=$1px" unless grep { /^width=/ } @attr; }
    elsif ($t =~ /^(izquierda|derecha)$/i)    { push @attr, "." . lc($1) unless grep { /^\./ } @attr; }
    elsif ($t ne "")                          { $raro = $t; }
  }
  if (defined $raro) {
    warn "   ⚠️  La dejé como está (tiene el texto \"$raro\" después del |): $original\n";
    $avisos++;
    return $original;
  }
  my $ruta = buscar($destino);
  if (!defined $ruta) {
    warn "   ⚠️  No encontré la imagen, la dejé como está: $original\n";
    $faltan++;
    return $original;
  }
  # Si tiene atributos (|300, |derecha) se conserva el wikilink ![[...]] para
  # no ensuciar Obsidian con {width=...}; md2pdf lo traduce al compilar.
  return $original if @attr;
  return "![](" . ruta_md($ruta) . ")";
}

sub revisar_estandar {
  my ($original, $alt, $dest, $titulo) = @_;
  my $d = $dest; $d =~ s/^<(.*)>$/$1/;
  my $dec = fs($d); $dec =~ s/%([0-9A-Fa-f]{2})/chr(hex($1))/ge; $dec = txt($dec);
  my $nombre = basename($dec);
  my $alt_nuevo = $alt;
  if (NFC(lc $alt) eq NFC(lc $nombre) || $alt =~ /^\s*(?:untitled|image|imagen|pasted image[^\]]*)(?:\.\w{3,4})?\s*$/i) {
    $alt_nuevo = "";
  }
  my $dest_nuevo = $dest;
  if ($d !~ m{^(?:[a-zA-Z][a-zA-Z0-9+.\-]*:|\#)}) {
    if ($d =~ m{^/}) {
      if (!-f fs($d)) { warn "   ⚠️  No encontré la imagen: $original\n"; $faltan++; }
    } elsif (!-f fs("$carpeta/$d") && !-f fs("$carpeta/$dec")) {
      my $ruta = buscar($dec);
      if (defined $ruta) {
        $dest_nuevo = ruta_md($ruta);
        aviso("La imagen $d no estaba en esa ruta: la cambié por $dest_nuevo.");
      } else {
        warn "   ⚠️  No encontré la imagen: $original\n"; $faltan++;
      }
    }
  }
  return $original if $alt_nuevo eq $alt && $dest_nuevo eq $dest;
  return "![$alt_nuevo]($dest_nuevo" . ($titulo // "") . ")";
}

sub imagenes_en_linea {
  my ($l) = @_;
  # Normalizar letras matemáticas Unicode (𝐴 𝑓 𝛼 -> A f α) fuera de código en línea
  $l =~ s{(`+)(.*?)\1|([\x{1D400}-\x{1D7FF}])}{
    defined $1 ? "$1$2$1" : NFKC($3)
  }ge;
  $l =~ s{(`+)(.*?)\1|!\[\[([^\[\]\n]+?)\]\]|!\[([^\[\]\n]*)\]\((<[^>\n]+>|[^)\s]+)(\s+"[^"\n]*")?\)}{
    defined $1 ? "$1$2$1" : defined $3 ? imagen_obsidian($&, $3) : revisar_estandar($&, $4, $5, $6)
  }ge;
  return formulas_en_linea($l);
}

sub formula {
  my ($m, $f) = @_;
  $f =~ s/^\s+|\s+$//g;
  return "$m$f$m";
}
sub formulas_en_linea {
  my ($l) = @_;
  return $l unless $l =~ /\\[(\[]/;
  my $simbolo = qr/[\\^_=\x{7B}]/;
  $l =~ s{(`+)(.*?)\1|\\\((.+?)\\\)|\\\[(.+?)\\\]}{
    defined $1 ? "$1$2$1"
    : defined $3 ? formula('$', $3)
    : $4 =~ $simbolo ? formula('$$', $4) : $&
  }ge;
  return $l;
}

# --- Tablas ---
sub celdas {
  my ($fila) = @_;
  my $s = $fila; $s =~ s/^\s+|\s+$//g;
  my @c; my $act = "";
  while (length $s) {
    if ($s =~ s/^(\\.)//)            { $act .= $1; }
    elsif ($s =~ s/^((`+).*?(?<!`)\2(?!`))//) { $act .= $1; }
    elsif ($s =~ s/^(\$\$.+?\$\$)//)  { $act .= $1; }
    elsif ($s =~ s/^(\$(?=\S)[^\$]*?(?<=\S)\$(?!\d))//) { $act .= $1; }
    elsif ($s =~ s/^\|//)             { push @c, $act; $act = ""; }
    else { $s =~ s/^(.)//s; $act .= $1; }
  }
  push @c, $act;
  shift @c if @c && $c[0] =~ /^\s*$/ && $fila =~ /^\s*\|/;
  pop @c   if @c && $c[-1] =~ /^\s*$/ && $fila =~ /\|\s*$/;
  s/^\s+|\s+$//g for @c;
  return @c;
}
sub es_separador {
  my ($l) = @_;
  return $l =~ /\|/ && $l =~ /^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?\s*$/;
}

sub br_a_espacio {
  my ($x) = @_;
  $x =~ s{(`+)(.*?)\1|\s*<br\s*/?>\s*}{ defined $1 ? $& : " " }gie;
  return $x;
}

sub arreglar_tabla {
  my ($sangria, @lineas) = @_;
  my @c = map { [ celdas($_) ] } @lineas;
  my $n = 0;
  for (@c) { $n = @$_ if @$_ > $n; }
  my $fila = sub { $sangria . "| " . join(" | ", @{$_[0]}) . " |" };
  my @res;
  for my $k (0..$#lineas) {
    my @f = @{ $c[$k] };
    my $cambia = 0;
    if ($k == 1) {
      if (@f < $n) { push @f, "---" while @f < $n; $cambia = 1; }
    } else {
      if (grep { /<br\s*\/?>/i } @f) { $_ = br_a_espacio($_) for @f; $cambia = 1; }
      if ($k == 0 && @f < $n) { push @f, "" while @f < $n; $cambia = 1; }
    }
    push @res, $cambia ? $fila->(\@f) . ($lineas[$k] =~ /\r$/ ? "\r" : "") : $lineas[$k];
  }
  return @res;
}

# --- Recorrido línea por línea ---
my @in = <STDIN>;
chomp @in;
my $bom = (@in && $in[0] =~ s/^\x{FEFF}//) ? "\x{FEFF}" : "";

# --- Encabezado de Notion ---
{
  my $p = 0;
  $p++ while $p < @in && $in[$p] !~ /\S/;
  if ($p < @in && $in[$p] =~ /^#[ \t]+(\S.*?)\s*$/) {
    my $titulo = $1;
    my $k = $p + 1;
    $k++ while $k < @in && $in[$k] !~ /\S/;
    my $j = $k;
    $j++ while $j < @in && $in[$j] =~ /^[^\s:#|>*\-\[!<`][^:]{0,40}:[ \t]+\S/;
    my $de_notion = ($ENV{NOMBRE_MD} // "") =~ /[0-9a-f]{32}\.(?:md|markdown)$/i;
    my $parecen = $j - $k >= 2 && !grep {
      my ($cl, $v) = /^([^:]+):\s*(.*?)\s*$/;
      $cl =~ /[.!?]/ || length($v) > 100 || $v =~ /[.!?]$/
    } @in[$k..$j-1];
    if ($j > $k && $k > $p + 1 && ($j == @in || $in[$j] !~ /\S/) && ($de_notion || $parecen)) {
      my $cr = $in[$p] =~ /\r$/ ? "\r" : "";
      my @props = map { (my $x = $_) =~ s/\s+$//; $x } @in[$k..$j-1];
      $_ .= "\\" for @props[0..$#props-1];
      my $valor = arreglar_valor($titulo) // $titulo;
      splice @in, $p, $j - $p, map { "$_$cr" } ("---", "title: $valor", "---", "", @props);
      my @nombres = map { /^([^:]+):/ ? $1 : () } @props;
      aviso("Encabezado de Notion: pasé el título \"$titulo\" a la cabecera YAML (title:).\n"
          . "      Las propiedades (" . join(", ", @nombres) . ") quedaron como texto al principio,\n"
          . "      así que salen en el PDF. Si no querés que salgan, pasalas a la cabecera\n"
          . "      (entre los ---): pandoc las guarda ahí pero no las muestra.");
    }
  }
}

# --- Cabecera YAML ---
sub aviso { warn "   ⚠️  $_[0]\n"; $avisos++; }

sub arreglar_valor {
  my ($v) = @_;
  my $t = $v; $t =~ s/\s+$//;
  return undef if $t eq "";
  return undef if $t =~ /^[|>][-+0-9]*$/;
  if ($t =~ /^"/) {
    my $sin = $t; $sin =~ s/\\.//g;
    my $n = () = $sin =~ /"/g;
    return $n % 2 ? qq{$t"} : undef;
  }
  if ($t =~ /^'/) {
    my $sin = $t; $sin =~ s/''//g;
    my $n = () = $sin =~ /'/g;
    return $n % 2 ? qq{$t'} : undef;
  }
  return undef if $t =~ /^\[.*\]$/ || $t =~ /^\{.*\}$/;
  my $hace_falta =
       $t =~ /:\s/ || $t =~ /:$/
    || $t =~ /\s#/
    || $t =~ /^[\@`\[\{*&!%?,|>#]/
    || $t =~ /^-\s/;
  return undef unless $hace_falta;
  (my $e = $t) =~ s/'/''/g;
  return "'$e'";
}

my $h = 0;
$h++ while $h < @in && $in[$h] !~ /\S/;
my $hay_yaml = $h + 1 < @in && $in[$h] =~ /^---\s*$/ && $in[$h+1] =~ /\S/;
my $clave_re = qr/[^\s#:'"\[\]{},&*!|>%@`?-][^:]*?/;
if ($hay_yaml) {
  my $cierre;
  for my $k ($h+1..$#in) { if ($in[$k] =~ /^(---|\.\.\.)\s*$/) { $cierre = $k; last; } }
  if (!defined $cierre) {
    my $k = $h + 1;
    while ($k < @in && $in[$k] =~ /\S/ && $in[$k] !~ /^#{1,6}\s/ &&
           ($in[$k] =~ /^\s/ || $in[$k] =~ /^-\s/ || $in[$k] =~ /^$clave_re:(?:\s|$)/ ||
            $in[$k] =~ /^[\w-]+:/ || $in[$k] =~ /^#/)) { $k++; }
    if ($k > $h + 1) {
      splice @in, $k, 0, ($in[$h] =~ /\r$/ ? "---\r" : "---");
      $cierre = $k;
      aviso("Faltaba el --- que cierra la cabecera: lo agregué después de la línea $k.");
    }
  }
  if (defined $cierre) {
    my (%visto);
    for my $k ($h+1..$cierre-1) {
      my $l = $in[$k];
      my $cr = $l =~ s/\r$// ? "\r" : "";
      if ($l =~ /^\s/ || $l !~ /\S/) { $in[$k] = $l . $cr; next; }
      if ($l =~ /^([\w-]+):(\S.*)$/ && $l !~ /^[\w-]+:\/\//) {
        aviso("Línea " . ($k+1) . ": faltaba el espacio después de \"$1:\".");
        $l = "$1: $2";
      }
      if ($l =~ /^($clave_re):(?=\s|$)(\s*)(.*)$/) {
        my ($clave, $esp, $valor) = ($1, $2, $3);
        push @{ $visto{$clave} }, $k+1;
        my $nuevo = arreglar_valor($valor);
        if (defined $nuevo) {
          aviso("Línea " . ($k+1) . ": " . ($valor =~ /^["']/ ? "cerré la comilla de" : "puse entre comillas") . " \"$clave\" ($nuevo).");
          $l = "$clave: $nuevo";
        }
      }
      $in[$k] = $l . $cr;
    }
    for my $clave (sort keys %visto) {
      my @ls = @{ $visto{$clave} };
      aviso("\"$clave\" está repetida (líneas " . join(", ", @ls) . "): pandoc usa la última. Borrá la que sobre.") if @ls > 1;
    }
  }
}

my @out;
my ($en_yaml, $en_codigo, $cerca, $en_math, $en_latex) = (0, 0, "", 0, 0);
my $en_lista = 0;
my $en_cita  = 0;
my ($cita_lista, $cita_previa) = (0, "");
my $item  = qr/^\s*(?:[-*+]|\d+[.)])\s+\S/;
my $item_inicio = qr/^\s{0,3}(?:[-*+]|\d{1,3}[.)])\s+\S/;
my $cita  = qr/^\s{0,3}>/;

my $vacia = (@in && $in[0] =~ /\r$/) ? "\r" : "";
sub blanco_antes { push @out, $vacia if @out && $out[-1] =~ /\S/; }

my @niveles;
sub ancho { my $n = 0; for (split //, $_[0]) { $n = $_ eq "\t" ? $n + 4 - $n % 4 : $n + 1; } $n }
sub sangrar_item {
  my ($l) = @_;
  my ($esp, $marca, $sep) = $l =~ /^(\s*)([-*+]|\d+[.)])(\s+)/ or return $l;
  my $w = ancho($esp);
  my $txt = length($marca) + (ancho($sep) > 4 ? 1 : ancho($sep));
  pop @niveles while @niveles && $niveles[-1][0] >= $w;
  my $nueva = $w;
  if (@niveles) {
    my ($pw, $pcont, $pnueva) = @{ $niveles[-1] };
    if ($w >= $pcont)      { $nueva = $w + $pnueva - $pcont; }
    elsif ($w >= $pw + 2)  { $nueva = $pnueva; }
  }
  push @niveles, [$w, $w + $txt, $nueva + $txt];
  return $l if $nueva == $w;
  $l =~ s/^\s*/" " x $nueva/e;
  return $l;
}

my $img_sola = qr/^\s{0,3}(?:!\[[^\]\n]*\]\([^)\n]*\)(?:\{[^}\n]*\})?|!\[\[[^\]\n]+\]\])\s*$/;
my $blanco_despues = 0;

sub saltos_html {
  my ($l, $sigue_texto, $es_titulo) = @_;
  return $l unless $l =~ /<br\s*\/?>/i;
  my $cr = $l =~ s/\r$// ? "\r" : "";
  my $marca = "\x{0}";
  $l =~ s{(`+)(.*?)\1|[ \t]*(?:<br\s*/?>[ \t]*)+}{ defined $1 ? "$1$2$1" : $marca }gei;
  if ($es_titulo) { $l =~ s/$marca/ /g; $l =~ s/ +$//; return $l . $cr; }
  $l =~ s/^(\s*)$marca+/$1/;
  if ($l =~ s/$marca$//) { $l .= "\\" if $sigue_texto && $l =~ /\S/; }
  my @partes = split /$marca/, $l, -1;
  for my $k (1..$#partes) {
    $partes[$k] =~ s/^([-*+#>])/\\$1/;
    $partes[$k] =~ s/^(\d+)([.)])/$1\\$2/;
  }
  return join("\\$cr\n", @partes) . $cr;
}

sub juntar {
  my $r = shift;
  for my $p (@_) {
    next if $p =~ /^<br\s*\/?>$/i;
    $r = ($r eq '') ? $p : "$r $p";
  }
  $r = br_a_espacio($r);
  return $r;
}
sub unir_fila {
  my ($j, $n) = @_;
  my @trozos;
  for (my $k = $j; $k < @in && $k < $j + 100; $k++) {
    my $x = $in[$k]; $x =~ s/\r$//;
    return if $k > $j && $x =~ /^\s*(#{1,6}\s|```|~~~|---\s*$)/;
    next if $x !~ /\S/;
    $x =~ s/^\s+|\s+$//g;
    push @trozos, $x;
    my $fila = juntar(@trozos);
    return ($fila, $k) if $fila =~ /\|$/ && scalar(my @c = celdas($fila)) >= $n;
  }
  return;
}

for (my $i = 0; $i < @in; $i++) {
  my $l = $in[$i];
  if ($blanco_despues && $l =~ /\S/) { blanco_antes(); }
  $blanco_despues = 0;

  if ($hay_yaml && $i == $h) { $en_yaml = 1; push @out, $l; next; }
  if ($en_yaml) { push @out, $l; $en_yaml = 0 if $l =~ /^(---|\.\.\.)\s*$/; next; }

  if ($en_codigo) {
    push @out, $l;
    $en_codigo = 0 if $l =~ /^\s*(`+|~+)\s*$/ && substr($1, 0, 1) eq substr($cerca, 0, 1) && length($1) >= length($cerca);
    next;
  }
  if ($l =~ /^\s*(```+|~~~+)/) { $cerca = $1; $en_codigo = 1; push @out, $l; next; }

  if ($l =~ /^(\s*)\\[\[\]]\s*$/) { my $cr = $l =~ /\r$/ ? "\r" : ""; $l = "$1\$\$$cr"; }

  if ($en_math) { push @out, $l; my $k = () = $l =~ /\$\$/g; $en_math = 0 if $k % 2; next; }
  if ($l =~ /^\s*\$\$/) { my $k = () = $l =~ /\$\$/g; $en_math = 1 if $k % 2; push @out, $l; next; }
  if ($en_latex) { push @out, $l; $en_latex += () = $l =~ /\\begin\{/g; $en_latex -= () = $l =~ /\\end\{/g; next; }
  if ($l =~ /^\s*\\begin\{/) {
    $en_latex = (() = $l =~ /\\begin\{/g) - (() = $l =~ /\\end\{/g);
    $en_latex = 0 if $en_latex < 0;
    push @out, $l; next;
  }

  if (!$en_lista && $l =~ /^\s*<aside>\s*$/i) {
    my $k = $i + 1;
    $k++ while $k < @in && $k < $i + 300 && $in[$k] !~ /^\s*<\/aside>\s*$/i;
    if ($k < @in && $in[$k] =~ /^\s*<\/aside>\s*$/i) {
      my $cr = $l =~ /\r$/ ? "\r" : "";
      my @c = map { (my $x = $_) =~ s/\s+$//; $x } @in[$i+1..$k-1];
      shift @c while @c && $c[0] !~ /\S/;
      pop @c   while @c && $c[-1] !~ /\S/;
      my @cita = map { (/\S/ ? "> $_" : ">") . $cr } @c;
      push @cita, $cr if $k + 1 < @in && $in[$k+1] =~ /\S/;
      splice @in, $i, $k - $i + 1, @cita;
      $i--; next;
    }
  }

  if ($l =~ /\|/ && $i + 1 < @in && es_separador($in[$i+1]) && !es_separador($l)) {
    my ($sangria) = $l =~ /^(\s*)/;
    my @t = ($l, $in[$i+1]);
    my $n = () = celdas($l);
    my $con_cierre = $l =~ /\|\s*\r?$/;
    my $j = $i + 2;
    while ($j < @in && $in[$j] =~ /\S/ && $in[$j] =~ /\|/) {
      my $fila = $in[$j];
      my $siguiente = $j + 1;
      $siguiente++ while $siguiente < @in && $in[$siguiente] !~ /\S/;
      my $pedazo = $siguiente < @in && $in[$siguiente] =~ /^\s+\||^\s*<br\s*\/?>/i;
      my $faltan_celdas = (() = celdas($fila)) < $n;
      if ($con_cierre && $fila !~ /\|\s*\r?$/ && ($faltan_celdas || $pedazo)
          && ($j + 1 >= @in || $in[$j+1] !~ /^\|/)) {
        my ($unida, $k) = unir_fila($j, $n);
        if (defined $unida) {
          aviso("Línea " . ($j+1) . ": la fila de la tabla estaba partida en " . ($k-$j+1) . " líneas; la junté en una.");
          push @t, $unida . $vacia;
          $j = $k + 1;
          next;
        }
        aviso("Línea " . ($j+1) . ": parece una fila de tabla partida en varias líneas, pero no la pude juntar. Revisala a mano.");
      }
      push @t, $fila; $j++;
    }
    blanco_antes();
    push @out, map { imagenes_en_linea($_) } arreglar_tabla($sangria, @t);
    $i = $j - 1; $en_lista = 0; $en_cita = 0; @niveles = ();
    next;
  }

  if ($l !~ /\S/) {
    push @out, $l; $en_cita = 0; ($cita_lista, $cita_previa) = (0, "");
    next;
  }

  my $es_titulo = $l =~ /^#{1,6}\s+\S/;
  if ($es_titulo) {
    blanco_antes();
    $en_lista = 0; $en_cita = 0; @niveles = ();
  } elsif ($l =~ $item) {
    if (!$en_lista && $l =~ $item_inicio) { blanco_antes(); @niveles = (); }
    $en_lista = 1 if $en_lista || $l =~ $item_inicio || ($out[-1] // "") !~ /\S/;
    $en_cita = 0;
    $l = sangrar_item($l) if $en_lista;
  } elsif ($en_lista && $l =~ /^\s+>/) {
    blanco_antes() if ($out[-1] // "") !~ /^\s*>/;
  } elsif ($l =~ $cita) {
    if (!$en_cita) { blanco_antes(); ($cita_lista, $cita_previa) = (0, ""); }
    my ($pre, $dentro) = $l =~ /^(\s{0,3}>)\s?(.*)$/;
    if ($en_cita && $dentro =~ $item_inicio && !$cita_lista && $cita_previa =~ /\S/) {
      push @out, $pre . $vacia;
    }
    if    ($dentro =~ $item)                               { $cita_lista = 1; }
    elsif ($dentro =~ /\S/ && $dentro !~ /^\s/ && $cita_previa !~ /\S/) { $cita_lista = 0; }
    $cita_previa = $dentro;
    $en_cita = 1;
  } elsif ($l !~ /^\s/ && ($out[-1] // "") !~ /\S/) {
    $en_lista = 0; @niveles = ();
  }
  if (!$es_titulo && !$en_lista && !$en_cita && $l =~ $img_sola) {
    blanco_antes(); $blanco_despues = 1;
  }

  my $sigue_texto = $i + 1 < @in && $in[$i+1] =~ /\S/;
  push @out, saltos_html(imagenes_en_linea($l), $sigue_texto, $es_titulo);
}
$out[0] = $bom . $out[0] if @out;
print "$_\n" for @out;
if ($ENV{FALTAN}) { open(my $f, ">", $ENV{FALTAN}) or die; print $f "$faltan $avisos\n"; close $f; }
PERL

# --- 2. Procesar cada archivo -------------------------------------------------
mostrar_cambios() {
  if command -v git >/dev/null 2>&1; then
    git --no-pager diff --no-index --color=auto -- "$1" "$2" | tail -n +5
  elif command -v diff >/dev/null 2>&1; then
    diff -u -- "$1" "$2" | tail -n +3
  fi
}

contar_cambiadas() {
  if command -v diff >/dev/null 2>&1; then
    diff -- "$1" "$2" | grep -c '^>' || true
  elif command -v git >/dev/null 2>&1; then
    git --no-pager diff --no-index --numstat -- "$1" "$2" | awk '{print $1}'
  else
    echo "varias"
  fi
}

fallidos=()
con_faltantes=()
pendientes_check=()
cuenta="$(mktemp)"
temporal=""
trap 'rm -f -- "$cuenta" ${temporal:+"$temporal"}' EXIT
trap 'echo; echo "Cancelado."; exit 130' INT TERM HUP

for archivo in "${archivos[@]}"; do
  temporal="$(mktemp --suffix=.md)"
  echo "── $archivo"
  dir_md="$(cd "$(dirname "$archivo")" && pwd -P)"
  base_dir="$(carpeta_de_busqueda "$dir_md")"
  nombre_md="$(basename "$archivo")"
  if ! CARPETA_MD="$dir_md" BASE="$base_dir" \
       FALTAN="$cuenta" NOMBRE_MD="$nombre_md" perl -CSD -e "$NORMALIZAR" < "$archivo" > "$temporal"; then
    echo "   ❌ Error al normalizar."
    fallidos+=("$archivo"); rm -f "$temporal"; continue
  fi
  read -r faltan avisos < "$cuenta"
  (( faltan > 0 )) && con_faltantes+=("$archivo ($faltan)")

  if [[ -s "$archivo" && "$(tail -c 1 -- "$archivo")" != "" ]]; then
    printf '%s' "$(<"$temporal")" > "$temporal"
  fi

  error_yaml=""
  primera="$(grep -m 1 -v '^[[:space:]]*$' -- "$temporal" || true)"
  if command -v pandoc >/dev/null 2>&1 && [[ "${primera#$'\xef\xbb\xbf'}" == ---* ]]; then
    error_yaml="$(pandoc -f markdown -t plain -o /dev/null -- "$temporal" 2>&1 | grep -i -A3 'yaml' || true)"
    if [[ -n "$error_yaml" ]]; then
      echo "   ❌ La cabecera YAML sigue con un error que no pude arreglar solo:"
      printf '%s\n' "$error_yaml" | sed 's/^/      /'
      (( opcion_check )) && fallidos+=("$archivo")
    fi
  fi

  if cmp -s -- "$archivo" "$temporal"; then
    if [[ -n "$error_yaml" ]] || (( faltan + avisos > 0 )); then
      echo "   No hay nada más para cambiar, pero revisá lo de arriba."
    else
      echo "   ✔ Ya estaba bien, sin cambios."
    fi
    rm -f "$temporal"; continue
  fi

  cambiadas="$(contar_cambiadas "$archivo" "$temporal")"
  if (( opcion_v )); then
    mostrar_cambios "$archivo" "$temporal"
  else
    echo "   $cambiadas línea(s) nueva(s) o cambiada(s). Para ver el detalle: mdnorm -v."
  fi

  if (( opcion_check )); then
    echo "   ⚠️ Requiere normalización (ejecutá: toolchain/bin/mdnorm \"$archivo\")."
    pendientes_check+=("$archivo")
    rm -f "$temporal"
    continue
  fi

  if (( ! opcion_y )); then
    read -r -p "¿Guardar los cambios en $archivo? [Y/n]: " respuesta || respuesta=n
    case "$respuesta" in
      y|Y|"") ;;
      *)
        echo "   Sin cambios."
        rm -f "$temporal"; continue
        ;;
    esac
  fi

  if cat -- "$temporal" > "$archivo"; then
    echo "   ✔ Guardado."
  else
    echo "   ❌ No se pudo guardar."
    fallidos+=("$archivo")
  fi
  rm -f "$temporal"
done

rm -f "$cuenta"

if (( ${#con_faltantes[@]} > 0 )); then
  echo "⚠️ Imágenes sin encontrar en: $(IFS=', '; echo "${con_faltantes[*]}")"
fi
if (( ${#pendientes_check[@]} > 0 )); then
  echo "⚠️ Archivos pendientes de normalizar (--check): $(IFS=', '; echo "${pendientes_check[*]}")"
fi
if (( ${#fallidos[@]} > 0 )); then
  echo "⚠️ Fallaron ${#fallidos[@]} archivo(s): $(IFS=', '; echo "${fallidos[*]}")"
fi
(( ${#fallidos[@]} + ${#con_faltantes[@]} + ${#pendientes_check[@]} == 0 )) || exit 1
